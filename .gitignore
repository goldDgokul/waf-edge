# Runtime WAF rules: generated per node by the deployment pipeline.
# These are OUTPUT, not source. Committing them is what made a fresh clone
# depend on a file the app is supposed to create, and it masked the fact that
# the vhost include had nothing to load on a clean machine.
#
# NOT `docker/shared/waf-rules/*` - basic.conf lives there and is real source:
# it holds the map blocks that drive the in-line SQLi/XSS/extension checks.
# Ignoring the directory would ignore the WAF's own detection rules.
docker/shared/waf-rules/dynamic-*.conf
docker/shared/waf-rules/agent-*/

# 0A.13 dev SSH keypair (see docker/nginx-node-1/ssh/).
# The PRIVATE key is a local secret and must never be committed; the PUBLIC key
# is committed as authorized_keys so the node image builds reproducibly.
# id_ed25519.pub is a byproduct of generate_keys.sh and is redundant with
# authorized_keys, so both generated key files are ignored.
docker/nginx-node-1/ssh/id_ed25519
docker/nginx-node-1/ssh/id_ed25519.pub

# Environment
.env
.env.local

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
coverage.xml


# nginx runtime output: docker-compose bind-mounts these directories as
# /var/log/nginx, so they fill up on every local run. 12.5 MB of them were
# committed. The directories themselves are kept, because the mount needs them.
docker/nginx-node-*/logs/*.log
